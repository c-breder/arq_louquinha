# Copie para .env e ajuste. O .env nunca vai para o git.
# Em desenvolvimento, tudo funciona sem .env (valores padrão de dev).

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 = modo de desenvolvimento. Em produção deixe 0.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ex.: https://meudominio.com.br (necessário atrás do Cloudflare)
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_NAME=arq_louquinha
# Caminho do admin (mudar dificulta robôs)
ADMIN_URL=admin/
# 0 fecha o cadastro de novas contas
SIGNUP_OPEN=1

# --- Banco (Postgres) ---
POSTGRES_DB=arq
POSTGRES_USER=arq
# Obrigatório trocar em produção
POSTGRES_PASSWORD=

# --- E-mail (em dev os e-mails aparecem no terminal) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=arq_louquinha <nao-responda@exemplo.com>

# --- Login com Google (opcional; vazio = desligado) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Segurança atrás do proxy/Cloudflare ---
# 1 só quando o site estiver atrás do Cloudflare Tunnel
TRUST_CF_CONNECTING_IP=0
SESSION_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# --- Imagens no texto (só autores no nível "Imagens") ---
MAX_IMAGE_UPLOAD_MB=5
IMAGE_QUOTA_MB=100
IMAGE_MAX_WIDTH=1600

# --- Recursos (deixe leve) ---
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=1
WEB_PORT=8000
DB_MEM_LIMIT=384m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=96mb
WEB_MEM_LIMIT=384m
WORKER_MEM_LIMIT=256m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=384MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=30

# Threads por worker do Gunicorn (atende outra página enquanto uma espera o banco)
GUNICORN_THREADS=4
